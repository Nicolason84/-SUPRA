+    def _tool_ids_path(self):
+        if not self.directory:
+            return "/experimental/tool/ids"
+        return "/experimental/tool/ids?directory=" + urllib.parse.quote(self.directory, safe="")
+
+    def _message_body(self, message):
+        body = {
+            "agent": self.agent,
+            "model": {
+                "providerID": self.provider_id,
+                "modelID": self.model,
+            },
+            "parts": [{"type": "text", "text": message}],
+        }
+        hard_no_tools = any(
+            line.strip().upper() == "NO_TOOLS=YES"
+            for line in str(message).splitlines()
+        )
+        if not hard_no_tools:
+            return body
+
+        tool_ids = self._get_json(
+            self._tool_ids_path(),
+            timeout=OPENCODE_READ_TIMEOUT,
+        )
+        if isinstance(tool_ids, dict):
+            tool_ids = tool_ids.get("data", tool_ids.get("tools", tool_ids.get("ids")))
+        if not isinstance(tool_ids, list):
+            raise OpenCodeAdapterError(
+                "NO_TOOLS_POLICY_UNPROVEN",
+                "OpenCode tool id inventory unavailable; refusing NO_TOOLS mission",
+            )
+        normalized = [str(tool_id).strip() for tool_id in tool_ids if str(tool_id).strip()]
+        if not normalized:
+            raise OpenCodeAdapterError(
+                "NO_TOOLS_POLICY_UNPROVEN",
+                "OpenCode tool id inventory empty; refusing NO_TOOLS mission",
+            )
+        body["tools"] = {tool_id: False for tool_id in sorted(set(normalized))}
+        return body
 

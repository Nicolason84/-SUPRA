+    def _media_contract(self, message):
+        fields = {}
+        for raw in str(message or "").splitlines():
+            line = raw.strip()
+            if "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            key = key.strip()
+            if key in {
+                "MEDIA_OBJECTIVE_ID", "ACTION", "SOURCE", "SOURCE_KIND",
+                "SOURCE_PROVIDER", "PROVIDER_GUARDRAIL",
+                "OJO_OBJECT_ID", "OJO_OBJECT_TYPE", "OJO_OBJECT_TITLE",
+                "OJO_OBJECT_LINEAGE", "INVOCATION_ORIGIN",
+            }:
+                fields[key] = value.strip()
+        objective_id = fields.get("MEDIA_OBJECTIVE_ID", "")
+        if not re.fullmatch(r"OJO_MEDIA_[A-Z0-9_]+_[0-9]{8}_[0-9]{6}_[A-F0-9]{8}", objective_id):
+            return None
+        action = fields.get("ACTION", "")
+        if action not in {"UNDERSTAND", "EVIDENCE", "LINEAGE", "MEMORY_RETURN"}:
+            raise ValueError("INVALID_MEDIA_ACTION")
+        return {
+            "objective_id": objective_id,
+            "action": action,
+            "source": fields.get("SOURCE", ""),
+            "source_kind": fields.get("SOURCE_KIND", "UNKNOWN"),
+            "source_provider": fields.get("SOURCE_PROVIDER", "UNKNOWN"),
+            "provider_guardrail": fields.get("PROVIDER_GUARDRAIL", ""),
+            "ojo_object_id": fields.get("OJO_OBJECT_ID", "UNSCOPED"),
+            "ojo_object_type": fields.get("OJO_OBJECT_TYPE", "UNSCOPED"),
+            "ojo_object_title": fields.get("OJO_OBJECT_TITLE", "UNSCOPED"),
+            "ojo_object_lineage": fields.get("OJO_OBJECT_LINEAGE", "NONE"),
+            "origin": fields.get("INVOCATION_ORIGIN", "ojO"),
+        }
+

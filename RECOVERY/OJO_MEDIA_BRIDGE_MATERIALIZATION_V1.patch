+            "ojo_object_id": contract["ojo_object_id"],
+            "ojo_object_type": contract["ojo_object_type"],
+            "ojo_object_title": contract["ojo_object_title"],
+            "ojo_object_lineage": contract["ojo_object_lineage"],
+            "invocation_origin": contract["origin"],
+            "canonical_write": "NO",
+            "runtime_route": "/v1/chat",
+        }
+        atomic_json(request_path, request)
+        contract.update({
+            "request_path": str(request_path),

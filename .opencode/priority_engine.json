{
  "version": "1.0.0",
  "engine": "SUPRA Priority Engine",
  "description": "Calculates mission priority, urgency, criticality, dependencies, and required resources automatically.",
  "calculation_rules": {
    "priority_score": {
      "formula": "base_priority + urgency_bonus + criticality_bonus",
      "components": {
        "base_priority": {"source": "mission_type", "mapping": {"architecture":10,"build":9,"route":9,"audit":8,"compliance":8,"analysis":7,"review":6,"runtime":6,"benchmark":5,"explore":5,"research":4,"report_generation":4,"provider_check":3,"model_check":3,"scheduler_test":2,"graph_analysis":9,"refactor":8}},
        "urgency_bonus": {"source": "urgency", "mapping": {"critical":3,"high":2,"medium":1,"low":0}},
        "criticality_bonus": {"source": "criticality", "mapping": {"critical":3,"high":1,"medium":0,"low":-1}}
      },
      "range": "0-16"
    },
    "urgency_score": {
      "formula": "dependency_count_penalty + waiting_time_factor",
      "dependency_count_penalty": "missions_blocking_others += 1 per dependent",
      "waiting_time_factor": "minutes_in_queue * 0.1, capped at 5",
      "range": "1-10"
    },
    "criticality_score": {
      "formula": "blocking_factor * 2 + agent_availability_factor + system_health_factor",
      "blocking_factor": "1 if mission blocks others, else 0",
      "agent_availability_factor": "1 if agent is contended (<2 available), else 0",
      "system_health_factor": "1 if system is degraded, else 0",
      "range": "0-4"
    }
  },
